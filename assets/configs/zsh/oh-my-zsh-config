# -----------------------------------------------------------------------------
# 基础配置
# -----------------------------------------------------------------------------

# 主题设置 (使用内置主题)
ZSH_THEME="robbyrussell"

# 禁用自动更新检查 (离线环境)
DISABLE_AUTO_UPDATE="true"
DISABLE_UPDATE_PROMPT="true"

# -----------------------------------------------------------------------------
# 插件配置
# -----------------------------------------------------------------------------
# 内置插件 (来自 oh-my-zsh 自带)
# - git: git 别名和功能
# - extract: 智能解压

# 自定义插件 (从 GitHub 下载，离线缓存)
# - z: 目录跳转
# - zsh-syntax-highlighting: 语法高亮
# - zsh-autosuggestions: 自动建议
